---
// Supervised theses, laid out like the publications: one group per kind (PhD,
// master's, bachelor's) that opens and closes, on a timeline by year. Each
// thesis has the id thesis-<slug>, so a tool's page can link to it.
//   self: the member whose profile this is, left out of the supervisors and
//         of those who supported it
//   idPrefix: keeps the groups' ids unique if a page has more than one list
import { thesisTypes, tools, defaultLang } from '../lib/data.js';
import { localize } from '../lib/content.js';
import { strings, loc } from '../lib/i18n.js';
import { postsAbout, inLanguage } from '../lib/news.js';

const { theses, lang, self, idPrefix = 'theses' } = Astro.props;
const t = strings(lang);
const r = t.research;
const L = (x) => loc(x, lang, defaultLang);
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const profileUrl = (id) => `${base}${lang}/team/${id}/`;
const collaboratorUrl = (id) => `${base}${lang}/team/#collaborator-${id}`;
// The tool a thesis developed: its name and page (if it is on the Tools pages).
const toolOf = (slug) => {
  const tool = slug && tools.find((x) => x.id === slug);
  return tool ? { name: localize(tool.entry, lang).title, href: `${base}${lang}/tools/${tool.id}/` } : null;
};

// News posts about each thesis (their `theses`), linked from its links row.
const newsOf = new Map(await Promise.all(theses.map(async (x) => [x.id, (await postsAbout('theses', x.id)).map((p) => inLanguage(p, lang))])));

const groups = thesisTypes
  .map((type) => ({ type, items: theses.filter((x) => x.type === type) }))
  .filter((g) => g.items.length);
---
<div class="publications theses">
  {groups.map((g) => (
    <div class="pub-group">
      <h3>
        <button type="button" class="group-toggle disclosure" aria-expanded="true" aria-controls={`${idPrefix}-${g.type}`}>
          {r.thesisGroups[g.type]} <span class="count">{g.items.length}</span>
        </button>
      </h3>
      <ol class="pubs" id={`${idPrefix}-${g.type}`}>
        {g.items.map((x, i) => {
          const where = [L(x.degree), L(x.institution)].filter(Boolean).join(', ');
          const people = [
            [r.supervisors, x.supervisors.filter((p) => !self || p.id !== self)],
            [r.support, x.support.filter((p) => !self || p.id !== self)],
          ].filter(([, list]) => list.length);
          const tool = toolOf(x.tool);
          return (
            <li class="pub" id={`thesis-${x.id}`}>
              {/* Timeline: the year is shown once per run of theses from the same year. */}
              <span class:list={['pub-year', { repeat: i > 0 && g.items[i - 1].year === x.year }]}><span class="year-label">{x.year ?? ''}</span></span>
              <div class="pub-body">
                <div class="pub-title">
                  {x.url ? <a href={x.url}>{x.title}</a> : x.title}
                  {x.ongoing && <span class="status-badge">{r.inProgress}</span>}
                </div>
                <div class="authors">{x.student}</div>
                {where && <div class="pub-meta"><em class="venue">{where}</em></div>}
                {people.length > 0 && (
                  <div class="pub-metrics">
                    {people.map(([label, list]) => (
                      <span>
                        {label}:{' '}
                        {list.map((p, j) => (
                          <>{p.member ? <a class="member" href={profileUrl(p.id)}>{p.name}</a> : p.collaborator ? <a class="member" href={collaboratorUrl(p.collaborator.id)}>{p.name}</a> : p.name}{j < list.length - 1 ? ', ' : ''}</>
                        ))}
                      </span>
                    ))}
                  </div>
                )}
                {(x.url || tool || newsOf.get(x.id).length > 0) && (
                  <div class="pub-links">
                    {x.url && <a href={x.url}>{r.document}</a>}
                    {tool && <a href={tool.href}>{r.tool}: {tool.name}</a>}
                    {newsOf.get(x.id).map((p) => <a class="news-link" href={`${base}${lang}/news/${p.slug}/`} title={p.title}>{t.news.kinds[p.kind]}</a>)}
                  </div>
                )}
              </div>
            </li>
          );
        })}
      </ol>
    </div>
  ))}
</div>

<script>
  import { setupToggles } from '../scripts/disclosure.js';

  setupToggles('.theses .group-toggle');
</script>
