---
// Supervised theses, laid out like the publications: one group per kind (PhD,
// master's, bachelor's) that opens and closes, on a timeline by year.
//   self: the member whose profile this is, left out of the supervisors
//   idPrefix: keeps the groups' ids unique if a page has more than one list
import { thesisTypes, defaultLang } from '../lib/data.js';
import { strings, loc } from '../lib/i18n.js';

const { theses, lang, self, idPrefix = 'theses' } = Astro.props;
const t = strings(lang);
const r = t.research;
const L = (x) => loc(x, lang, defaultLang);
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const profileUrl = (id) => `${base}${lang}/team/${id}/`;

const groups = thesisTypes
  .map((type) => ({ type, items: theses.filter((x) => x.type === type) }))
  .filter((g) => g.items.length);
---
<div class="publications theses">
  {groups.map((g) => (
    <div class="pub-group">
      <h3>
        <button type="button" class="group-toggle disclosure" aria-expanded="true" aria-controls={`${idPrefix}-${g.type}`}>
          {r.thesisGroups[g.type]} <span class="count">{g.items.length}</span>
        </button>
      </h3>
      <ol class="pubs" id={`${idPrefix}-${g.type}`}>
        {g.items.map((x, i) => {
          const where = [L(x.degree), L(x.institution)].filter(Boolean).join(', ');
          const supervisors = x.supervisors.filter((p) => !self || p.id !== self);
          return (
            <li class="pub">
              {/* Timeline: the year is shown once per run of theses from the same year. */}
              <span class:list={['pub-year', { repeat: i > 0 && g.items[i - 1].year === x.year }]}><span class="year-label">{x.year ?? ''}</span></span>
              <div class="pub-body">
                <div class="pub-title">
                  {x.url ? <a href={x.url}>{x.title}</a> : x.title}
                  {x.ongoing && <span class="status-badge">{r.inProgress}</span>}
                </div>
                <div class="authors">{x.student}</div>
                {where && <div class="pub-meta"><em class="venue">{where}</em></div>}
                {supervisors.length > 0 && (
                  <div class="pub-metrics">
                    <span>
                      {r.supervisors}:{' '}
                      {supervisors.map((p, j) => (
                        <>{p.member ? <a class="member" href={profileUrl(p.id)}>{p.name}</a> : p.collaborator ? <a class="member" href={`${base}${lang}/team/#collaborator-${p.collaborator.id}`}>{p.name}</a> : p.name}{j < supervisors.length - 1 ? ', ' : ''}</>
                      ))}
                    </span>
                  </div>
                )}
                {x.url && <div class="pub-links"><a href={x.url}>{r.document}</a></div>}
              </div>
            </li>
          );
        })}
      </ol>
    </div>
  ))}
</div>

<script>
  import { setupToggles } from '../scripts/disclosure.js';

  setupToggles('.theses .group-toggle');
</script>
