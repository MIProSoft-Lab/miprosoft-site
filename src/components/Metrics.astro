---
// Citation summary: stat tiles plus a citations-per-year column chart.
import { strings } from '../lib/i18n.js';

const { metrics, lang } = Astro.props;
const t = strings(lang).metrics;
const fmt = new Intl.NumberFormat(lang, { notation: 'compact', maximumFractionDigits: 1 });

const tiles = [
  ['publications', metrics.publications],
  ['citations', metrics.citations],
  ['hIndex', metrics.hIndex],
  ['i10Index', metrics.i10Index],
];

// A chart with one or two columns says nothing the "Citations" tile doesn't.
const perYear = metrics.perYear;
const showChart = perYear.length >= 3;
const max = Math.max(1, ...perYear.map((p) => p.citations));
const peak = perYear.reduce((a, b) => (b.citations >= a.citations ? b : a), perYear[0] ?? {});
// Label every year when there are few, otherwise every other one plus the last.
const showYear = (i) => perYear.length <= 8 || i % 2 === (perYear.length - 1) % 2;
---
{metrics.citations > 0 && (
  <div class="metrics">
    <dl class="tiles">
      {tiles.map(([key, value]) => (
        <div class="tile">
          <dt>{t[key]}</dt>
          <dd>{fmt.format(value)}</dd>
        </div>
      ))}
    </dl>

    {showChart && (
      <figure class="cites-chart">
        <figcaption>{t.perYear}</figcaption>
        <div class="bars" role="img" aria-label={`${t.perYear}: ${perYear.map((p) => `${p.year} ${p.citations}`).join(', ')}`}>
          {perYear.map((p, i) => (
            <div class="bar-slot" tabindex="0" data-tip={`${p.year}: ${p.citations}`} aria-hidden="true">
              {p === peak && <span class="bar-value" style={`bottom: ${(p.citations / max) * 100}%`}>{p.citations}</span>}
              <span class="bar" style={`height: ${(p.citations / max) * 100}%`}></span>
            </div>
          ))}
        </div>
        <div class="bar-years" aria-hidden="true">
          {perYear.map((p, i) => <span>{showYear(i) ? p.year : ''}</span>)}
        </div>
        <table class="visually-hidden">
          <caption>{t.perYear}</caption>
          <tr><th scope="col">{t.year}</th><th scope="col">{t.citations}</th></tr>
          {perYear.map((p) => <tr><td>{p.year}</td><td>{p.citations}</td></tr>)}
        </table>
      </figure>
    )}

    <p class="metrics-source">{t.source} <a href="https://openalex.org">OpenAlex</a></p>
  </div>
)}
