---
// The group's social networks (group.social in site.config.yaml), as a list of
// links with their logos. Nothing is rendered when none has a URL.
//   class:  footer-social (round icons) | hero-social (icon and name, on the banner)
//   labels: show the network's name next to its logo
import { group } from '../lib/data.js';
import { strings } from '../lib/i18n.js';
import { socialIcons } from '../lib/social.js';

const { lang, class: className, labels = false } = Astro.props;
const t = strings(lang);
const social = group.social.filter((s) => socialIcons[s.network]);
---
{social.length > 0 && (
  <ul class={className}>
    {social.map((s) => {
      const name = socialIcons[s.network].name;
      const label = `${t.followUs} ${name}`;
      return (
        <li><a href={s.url} rel="me noopener" target="_blank" aria-label={label} title={label}>
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={socialIcons[s.network].path} /></svg>
          {labels && <span aria-hidden="true">{name}</span>}
        </a></li>
      );
    })}
  </ul>
)}
