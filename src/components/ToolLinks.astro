---
// A tool's links, the same on its card and on its own page: the first one as a
// button (e.g. the tool itself), the rest as links (the code, a demo, a paper…).
// Links to GitHub get its logo.
//   links: [{ url, label }] (from linksOf)
//   name:  optional, the tool's name, added for screen readers where several
//          tools' links sit on one page (e.g. "Try it: MLProcessMap")
const { links = [], name } = Astro.props;
const isGitHub = (url) => {
  try { return new URL(url).hostname.replace(/^www\./, '') === 'github.com'; } catch { return false; }
};
---
{links.length > 0 && (
  <div class="tool-links">
    {links.map((l, i) => (
      <a class:list={[{ button: i === 0 }]} href={l.url} rel="noopener">
        {isGitHub(l.url) && (
          <svg class="tool-link-icon" viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z" /></svg>
        )}
        {l.label}{name && <span class="visually-hidden">: {name}</span>}{i === 0 && <span aria-hidden="true"> →</span>}
      </a>
    ))}
  </div>
)}
