---
// One supervised thesis: year (or "in progress") on the left; title, student,
// degree and institution, and supervisors on the right. `showType` adds the
// kind of thesis (for lists that mix them, e.g. a member's profile); `self` is
// the member whose profile this is, left out of the supervisors.
import { defaultLang } from '../lib/data.js';
import { strings, loc } from '../lib/i18n.js';

const { thesis, lang, showType = false, self } = Astro.props;
const t = strings(lang);
const r = t.research;
const L = (x) => loc(x, lang, defaultLang);
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const where = [L(thesis.degree), L(thesis.institution)].filter(Boolean).join(', ');
const supervisors = thesis.supervisors.filter((p) => !self || p.id !== self);
---
<div class="entry thesis">
  <div class="when">
    {thesis.ongoing ? <span class="status-badge">{r.inProgress}</span> : thesis.year}
  </div>
  <div class="what">
    <div class="title">{thesis.url ? <a href={thesis.url}>{thesis.title}</a> : thesis.title}</div>
    <div class="subtitle">{[thesis.student, showType && r.thesisTypes[thesis.type]].filter(Boolean).join(' — ')}</div>
    {where && <div class="meta">{where}</div>}
    {supervisors.length > 0 && (
      <div class="meta">
        {r.supervisors}:{' '}
        {supervisors.map((p, i) => (
          <>{p.member ? <a href={`${base}${lang}/team/${p.id}/`}>{p.name}</a> : p.name}{i < supervisors.length - 1 ? ', ' : ''}</>
        ))}
      </div>
    )}
  </div>
</div>
