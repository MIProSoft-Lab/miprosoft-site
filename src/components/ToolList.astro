---
// The tools of one section, research or teaching (content/tools/*/index.yaml
// with that tag), as cards, as the whole of its Tools page. Each card has the
// tool's summary, its name linking to its own page (src/pages/[lang]/tools/[slug]/),
// and the same links as that page (ToolLinks).
//   lang, section: 'research' | 'teaching'
import Base from '../layouts/Base.astro';
import PageHead from './PageHead.astro';
import ToolCard from './ToolCard.astro';
import { toolsFor, group, defaultLang } from '../lib/data.js';
import { strings, loc } from '../lib/i18n.js';

const { lang, section } = Astro.props;
const t = strings(lang);
const x = t.tools;
const page = x[section];
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const name = loc(group.name, lang, defaultLang);
---
<Base lang={lang} nav={section} subnav="tools" path={`${section}/tools/`} title={`${page.title} — ${name}`} description={page.lead} lastModified={null}>
  <PageHead slot="hero" title={page.title} lead={page.lead} crumbs={[{ label: t.nav.home, href: `${base}${lang}/` }, { label: t.nav[section] }]} />

  <ul class="card-list">
    {toolsFor(section).map((tool) => <ToolCard tool={tool} lang={lang} />)}
  </ul>
</Base>
