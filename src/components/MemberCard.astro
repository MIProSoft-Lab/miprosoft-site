---
// A member on the home and team pages: photo, name (with a badge for principal
// investigators), and title or current affiliation. The whole card links to the profile.
import Avatar from './Avatar.astro';
import { defaultLang } from '../lib/data.js';
import { strings, loc } from '../lib/i18n.js';

const { member, lang } = Astro.props;
const t = strings(lang);
const L = (x) => loc(x, lang, defaultLang);
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const role = L(member.profile.title) || L(member.affiliation?.role);
const org = member.affiliation?.organization?.name;
---
<li class="member-card">
  <Avatar member={member} size={64} />
  <div class="member-card-body">
    <a class="member-card-name" href={`${base}${lang}/team/${member.id}/`}>{member.name}</a>
    {member.pi && <span class="pi-badge" title={t.team.piTitle}>{t.team.pi}<span class="visually-hidden"> ({t.team.piTitle})</span></span>}
    {role && <span class="member-card-role">{role}</span>}
    {org && <span class="member-card-org">{org}</span>}
  </div>
</li>
