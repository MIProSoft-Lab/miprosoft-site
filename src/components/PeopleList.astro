---
// People with their photo, members linking to their profiles and collaborators
// to their card on the team page (authors of a post, instructors of a course,
// researchers of a research line).
// `people` comes from peopleOf() in src/lib/data.js. `stacked`: one per line.
import Avatar from './Avatar.astro';

const { people, lang, stacked = false, label } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<ul class:list={['post-authors', { stacked }]} aria-label={label}>
  {people.map((p) => (
    <li>
      {p.member
        ? <a href={`${base}${lang}/team/${p.id}/`}><Avatar member={p.member} size={32} /><span>{p.name}</span></a>
        : p.collaborator
          ? <a href={`${base}${lang}/team/#collaborator-${p.collaborator.id}`}><Avatar member={p.collaborator} size={32} /><span>{p.name}</span></a>
          : <span>{p.name}</span>}
    </li>
  ))}
</ul>
