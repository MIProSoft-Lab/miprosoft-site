---
// A CV section whose heading opens and closes it. `collapsed` starts it closed.
const { id, title, collapsed = false } = Astro.props;
---
<section id={id} class="section">
  <h2>
    <button type="button" class="section-toggle disclosure" aria-expanded={String(!collapsed)} aria-controls={`${id}-body`}>{title}</button>
  </h2>
  <div class="section-body" id={`${id}-body`} hidden={collapsed}>
    <slot />
  </div>
</section>

<script>
  import { setupToggles, setExpanded } from '../scripts/disclosure.js';

  setupToggles('.section-toggle');

  // Following a link to a closed section (#publications) opens it.
  const openTarget = () => {
    const id = decodeURIComponent(location.hash.slice(1));
    const toggle = id && document.querySelector(`#${CSS.escape(id)} > h2 > .section-toggle`);
    if (toggle?.getAttribute('aria-expanded') === 'false') setExpanded(toggle, true, { animate: false });
  };
  openTarget();
  addEventListener('hashchange', openTarget);
</script>
