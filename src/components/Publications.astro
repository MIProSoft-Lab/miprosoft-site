---
import { strings } from '../lib/i18n.js';
import { workGroupOrder } from '../lib/data.js';

const { works, lang, nameVariants, familyName = '', givenNames = '', showCitations, showAbstracts = true, showImpactFactor = true } = Astro.props;
const t = strings(lang);

const norm = (s) => s.normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[.\s]+/g, ' ').trim().toLowerCase();
const variants = new Set(nameVariants.map(norm));
const family = norm(familyName).split(' ').filter(Boolean);
const initial = norm(givenNames).charAt(0);
// Exact variant, or a matching first initial plus the first family name, so that
// "J. S. Carberry" matches Carberry and "Antonio Crespí" matches Crespí Tobeña.
const isMe = (author) => {
  const a = norm(author);
  if (variants.has(a)) return true;
  const tokens = a.split(' ');
  return family.length > 0 && a.charAt(0) === initial && tokens.slice(1).includes(family[0]);
};

// "cc-by-nc-nd" -> "CC BY-NC-ND"; values like "CC BY-NC-ND 4.0" are kept.
const licenseName = (l) => (/^cc-/i.test(l) ? l.toUpperCase().replace(/^CC-/, 'CC ') : l);
const oaTooltip = (oa) =>
  [t.oaStatus[oa.status] ?? t.openAccess, oa.license && `${t.license}: ${licenseName(oa.license)}`].filter(Boolean).join(' · ');

// "JIF 2025: 3.3 · Q1, 12/131 in Software Engineering", or "JCR 2025: Q1, 12/131 in …" without a JIF.
const jcrText = (j) => {
  const position = [[j.quartile, j.rank].filter(Boolean).join(', '), j.category].filter(Boolean).join(` ${t.inCategory} `);
  return j.value != null
    ? [`JIF ${j.year}: ${Number.isInteger(j.value) ? j.value.toFixed(1) : j.value}`, position].filter(Boolean).join(' · ')
    : `JCR ${j.year}: ${position}`;
};

const hasAbstract = (w) => showAbstracts && Boolean(w.abstract || w.tldr);

const hasSelected = works.some((w) => w.selected);
const groups = workGroupOrder
  .map((g) => ({ id: g, items: works.filter((w) => w.group === g) }))
  .filter((g) => g.items.length);
---
{hasSelected && (
  <div class="pub-toggle" role="group">
    <button type="button" data-filter="selected" aria-pressed="true">{t.selected}</button>
    <button type="button" data-filter="all" aria-pressed="false">{t.all} ({works.length})</button>
  </div>
)}
<div class="publications" data-mode={hasSelected ? 'selected' : 'all'}>
  {groups.map((g) => (
    <div class:list={['pub-group', { 'has-selected': g.items.some((w) => w.selected) }]}>
      {groups.length > 1 && <h3>{t.workGroups[g.id]} <span class="count">{g.items.length}</span></h3>}
      <ol class="pubs">
        {g.items.map((w, i) => (
          <li class:list={['pub', { selected: w.selected }]}>
            {/* Timeline: the year is shown once per run of works from the same year. */}
            <span class:list={['pub-year', { repeat: i > 0 && g.items[i - 1].date?.year === w.date?.year }]}><span class="year-label">{w.date?.year ?? ''}</span></span>
            <div class="pub-body">
              <div class="pub-title">
                {w.url ? <a href={w.url}>{w.title}</a> : w.title}
                {w.openAccess && (
                  <span class:list={['oa-badge', `oa-${w.openAccess.status}`]} title={oaTooltip(w.openAccess)}>
                    <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M5 7V5a3 3 0 0 1 5.8-1.1" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /><rect x="3" y="7" width="10" height="7.5" rx="1.5" fill="currentColor" /></svg>
                    {t.openAccess}
                    <span class="visually-hidden">: {oaTooltip(w.openAccess)}</span>
                  </span>
                )}
              </div>
              {w.authors?.length > 0 && (
                <div class="authors">
                  {w.authors.map((a, j) => (
                    <>{isMe(a) ? <strong>{a}</strong> : a}{j < w.authors.length - 1 ? ', ' : ''}</>
                  ))}
                </div>
              )}
              {/* Where it was published, then how the journal and the work rank, then links. */}
              {w.venue || w.volume || w.pages ? (
                <div class="pub-meta">
                  {w.venue && <em class="venue">{w.venue}</em>}
                  {w.volume && <span>{w.venue && ', '}{w.volume}{w.issue && `(${w.issue})`}</span>}
                  {w.pages && <span>{(w.venue || w.volume) && ', '}{w.pages}</span>}
                </div>
              ) : null}
              {((showImpactFactor && w.jif) || (showCitations && w.citations > 0)) && (
                <div class="pub-metrics">
                  {showImpactFactor && w.jif && (
                    <span class="jif" title={[(w.jif.value != null ? t.jifTooltip : t.jcrTooltip)(w.jif.year), w.jif.percentile != null && `${t.percentile} ${w.jif.percentile}`].filter(Boolean).join(' · ')}>
                      {jcrText(w.jif)}
                    </span>
                  )}
                  {showCitations && w.citations > 0 && <span class="citations">{t.citations(w.citations)}</span>}
                </div>
              )}
              {(w.doi || w.arxiv || w.openAccessUrl || hasAbstract(w)) && (
                <div class="pub-links">
                  {w.doi && <a href={`https://doi.org/${w.doi}`}>DOI</a>}
                  {w.arxiv && <a href={`https://arxiv.org/abs/${w.arxiv}`}>arXiv</a>}
                  {w.openAccessUrl && <a href={w.openAccessUrl}>PDF</a>}
                  {hasAbstract(w) && (
                    <button type="button" class="abstract-toggle" aria-expanded="false" aria-controls={`abstract-${g.id}-${i}`}>{t.abstract}</button>
                  )}
                </div>
              )}
              {hasAbstract(w) && (
                <div class="abstract-body" id={`abstract-${g.id}-${i}`} hidden>
                  {w.tldr && <p class="tldr"><span>{t.tldr}:</span> {w.tldr} <span class="source">({t.via} Semantic Scholar)</span></p>}
                  {w.abstract && <p>{w.abstract}</p>}
                  {w.abstractSource && <p class="source">{t.abstract} {t.via} {w.abstractSource}</p>}
                </div>
              )}
            </div>
          </li>
        ))}
      </ol>
    </div>
  ))}
</div>

<script>
  for (const btn of document.querySelectorAll('.pub-toggle button')) {
    btn.addEventListener('click', () => {
      document.querySelector('.publications').dataset.mode = btn.dataset.filter;
      for (const b of document.querySelectorAll('.pub-toggle button')) b.setAttribute('aria-pressed', String(b === btn));
    });
  }

  // Slide abstracts open and closed with the Web Animations API. The toggle sits
  // in the links row and the abstract below it, so this is a button, not <details>.
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
  for (const toggle of document.querySelectorAll('.abstract-toggle')) {
    const body = document.getElementById(toggle.getAttribute('aria-controls'));
    let animation = null;

    toggle.addEventListener('click', () => {
      const opening = toggle.getAttribute('aria-expanded') !== 'true';
      toggle.setAttribute('aria-expanded', String(opening));
      if (reduceMotion.matches) {
        body.hidden = !opening;
        return;
      }
      // Start from the current height so a click mid-animation reverses smoothly.
      const from = body.hidden ? '0px' : `${body.getBoundingClientRect().height}px`;
      animation?.cancel();
      body.hidden = false;
      const to = opening ? `${body.scrollHeight}px` : '0px';
      animation = body.animate(
        { height: [from, to], opacity: opening ? [0, 1] : [1, 0] },
        { duration: 220, easing: 'cubic-bezier(0.2, 0, 0, 1)' },
      );
      animation.onfinish = () => {
        animation = null;
        body.hidden = !opening;
      };
    });
  }
</script>
