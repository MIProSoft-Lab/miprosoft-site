---
import { strings } from '../lib/i18n.js';
import { workGroupOrder } from '../lib/data.js';
import { authorMatcher } from '../lib/authors.js';

// In author lists, `self` (the id of the member whose profile this is) is shown in
// bold, and the other `members` link to their profiles.
//   flat:   one list, without the per-type groups (e.g. latest publications)
//   filter: a menu to show only one member's works (group publications page)
const { works, lang, members = [], self, flat = false, filter = false, showCitations, showAbstracts = true, showImpactFactor = true } = Astro.props;
const t = strings(lang);
const memberOf = authorMatcher(members);
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const profileUrl = (m) => `${base}${lang}/people/${m.id}/`;

// "cc-by-nc-nd" -> "CC BY-NC-ND"; values like "CC BY-NC-ND 4.0" are kept.
const licenseName = (l) => (/^cc-/i.test(l) ? l.toUpperCase().replace(/^CC-/, 'CC ') : l);
const oaTooltip = (oa) =>
  [t.oaStatus[oa.status] ?? t.openAccess, oa.license && `${t.license}: ${licenseName(oa.license)}`].filter(Boolean).join(' · ');

// "JIF 2025: 3.3 · Q1, 12/131 in Software Engineering", or "JCR 2025: Q1, 12/131 in …" without a JIF.
const jcrText = (j) => {
  const position = [[j.quartile, j.rank].filter(Boolean).join(', '), j.category].filter(Boolean).join(` ${t.inCategory} `);
  return j.value != null
    ? [`JIF ${j.year}: ${Number.isInteger(j.value) ? j.value.toFixed(1) : j.value}`, position].filter(Boolean).join(' · ')
    : `JCR ${j.year}: ${position}`;
};

const hasAbstract = (w) => showAbstracts && Boolean(w.abstract || w.tldr);

const hasSelected = works.some((w) => w.selected);
const groups = flat
  ? [{ id: 'all', items: works }]
  : workGroupOrder
      .map((g) => ({ id: g, items: works.filter((w) => w.group === g) }))
      .filter((g) => g.items.length);
// Members with works in this list, for the filter.
const authors = filter ? members.filter((m) => works.some((w) => w.members?.includes(m.id))) : [];
---
{authors.length > 1 && (
  <div class="member-filter">
    <label>
      <span>{t.filterByMember}</span>
      <select>
        <option value="">{t.allMembers} ({works.length})</option>
        {authors.map((m) => <option value={m.id}>{m.name} ({works.filter((w) => w.members?.includes(m.id)).length})</option>)}
      </select>
    </label>
    <p class="member-filter-status" aria-live="polite" data-template={t.showing({ n: '{n}', total: '{total}' })}></p>
  </div>
)}
{hasSelected && (
  <div class="pub-toggle" role="group">
    <button type="button" data-filter="selected" aria-pressed="true">{t.selected}</button>
    <button type="button" data-filter="all" aria-pressed="false">{t.all} ({works.length})</button>
  </div>
)}
<div class="publications" data-mode={hasSelected ? 'selected' : 'all'}>
  {groups.map((g) => (
    <div class:list={['pub-group', { 'has-selected': g.items.some((w) => w.selected) }]}>
      {groups.length > 1 && (
        <h3>
          <button type="button" class="group-toggle disclosure" aria-expanded="true" aria-controls={`pubs-${g.id}`}>
            {t.workGroups[g.id]} <span class="count">{g.items.length}</span>
          </button>
        </h3>
      )}
      <ol class="pubs" id={`pubs-${g.id}`}>
        {g.items.map((w, i) => (
          <li class:list={['pub', { selected: w.selected }]} data-members={(w.members ?? []).join(' ')} data-year={w.date?.year ?? ''}>
            {/* Timeline: the year is shown once per run of works from the same year. */}
            <span class:list={['pub-year', { repeat: i > 0 && g.items[i - 1].date?.year === w.date?.year }]}><span class="year-label">{w.date?.year ?? ''}</span></span>
            <div class="pub-body">
              <div class="pub-title">
                {w.url ? <a href={w.url}>{w.title}</a> : w.title}
                {w.openAccess && (
                  <span class:list={['oa-badge', `oa-${w.openAccess.status}`]} title={oaTooltip(w.openAccess)}>
                    <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M5 7V5a3 3 0 0 1 5.8-1.1" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /><rect x="3" y="7" width="10" height="7.5" rx="1.5" fill="currentColor" /></svg>
                    {t.openAccess}
                    <span class="visually-hidden">: {oaTooltip(w.openAccess)}</span>
                  </span>
                )}
              </div>
              {w.authors?.length > 0 && (
                <div class="authors">
                  {w.authors.map((a, j) => (
                    <>{(() => {
                      const m = memberOf(a);
                      if (!m) return a;
                      if (m.id === self) return <strong>{a}</strong>;
                      return <a class="member" href={profileUrl(m)} title={m.profile?.name}>{a}</a>;
                    })()}{j < w.authors.length - 1 ? ', ' : ''}</>
                  ))}
                </div>
              )}
              {/* Where it was published, then how the journal and the work rank, then links. */}
              {w.venue || w.volume || w.pages ? (
                <div class="pub-meta">
                  {w.venue && <em class="venue">{w.venue}</em>}
                  {w.volume && <span>{w.venue && ', '}{w.volume}{w.issue && `(${w.issue})`}</span>}
                  {w.pages && <span>{(w.venue || w.volume) && ', '}{w.pages}</span>}
                </div>
              ) : null}
              {((showImpactFactor && w.jif) || (showCitations && w.citations > 0)) && (
                <div class="pub-metrics">
                  {showImpactFactor && w.jif && (
                    <span class="jif" title={[(w.jif.value != null ? t.jifTooltip : t.jcrTooltip)(w.jif.year), w.jif.percentile != null && `${t.percentile} ${w.jif.percentile}`].filter(Boolean).join(' · ')}>
                      {jcrText(w.jif)}
                    </span>
                  )}
                  {showCitations && w.citations > 0 && <span class="citations">{t.citations(w.citations)}</span>}
                </div>
              )}
              {(w.doi || w.arxiv || w.openAccessUrl || hasAbstract(w)) && (
                <div class="pub-links">
                  {w.doi && <a href={`https://doi.org/${w.doi}`}>DOI</a>}
                  {w.arxiv && <a href={`https://arxiv.org/abs/${w.arxiv}`}>arXiv</a>}
                  {w.openAccessUrl && <a href={w.openAccessUrl}>PDF</a>}
                  {hasAbstract(w) && (
                    <button type="button" class="abstract-toggle disclosure" aria-expanded="false" aria-controls={`abstract-${g.id}-${i}`}>{t.abstract}</button>
                  )}
                </div>
              )}
              {hasAbstract(w) && (
                <div class="abstract-body" id={`abstract-${g.id}-${i}`} hidden>
                  {w.tldr && <p class="tldr"><span>{t.tldr}:</span> {w.tldr} <span class="source">({t.via} Semantic Scholar)</span></p>}
                  {w.abstract && <p>{w.abstract}</p>}
                  {w.abstractSource && <p class="source">{t.abstract} {t.via} {w.abstractSource}</p>}
                </div>
              )}
            </div>
          </li>
        ))}
      </ol>
    </div>
  ))}
</div>

<script>
  import { setupToggles } from '../scripts/disclosure.js';

  for (const btn of document.querySelectorAll('.pub-toggle button')) {
    btn.addEventListener('click', () => {
      document.querySelector('.publications').dataset.mode = btn.dataset.filter;
      for (const b of document.querySelectorAll('.pub-toggle button')) b.setAttribute('aria-pressed', String(b === btn));
    });
  }

  // The abstract toggle sits in the links row and the abstract below it, so
  // this is a button, not <details>.
  setupToggles('.group-toggle, .abstract-toggle');

  // Member filter: hide other works, then fix the group counts and the timeline
  // (the year is shown on the first visible work of each year).
  const select = document.querySelector('.member-filter select');
  if (select) {
    const status = document.querySelector('.member-filter-status');
    const total = document.querySelectorAll('.publications .pub').length;
    const apply = () => {
      const id = select.value;
      let shown = 0;
      for (const group of document.querySelectorAll('.publications .pub-group')) {
        let n = 0;
        let previousYear = null;
        for (const li of group.querySelectorAll('.pub')) {
          li.hidden = Boolean(id) && !li.dataset.members.split(' ').includes(id);
          if (li.hidden) continue;
          li.querySelector('.pub-year').classList.toggle('repeat', n > 0 && li.dataset.year === previousYear);
          previousYear = li.dataset.year;
          n++;
        }
        group.hidden = n === 0;
        const count = group.querySelector('.count');
        if (count) count.textContent = String(n);
        shown += n;
      }
      status.textContent = id ? status.dataset.template.replace('{n}', shown).replace('{total}', total) : '';
    };
    select.addEventListener('change', apply);
    // Keep the choice when coming back to the page.
    if (select.value) apply();
  }
</script>
