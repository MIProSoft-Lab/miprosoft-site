---
// A post in a list: cover image (if any), kind and date, title, summary.
// `post` comes from inLanguage() in src/lib/news.js.
// `row`: a wide card with the image on the left (home and news pages) instead of on top.
import { Image } from 'astro:assets';
import { strings } from '../lib/i18n.js';

const { post, lang, headingLevel = 3, row = false } = Astro.props;
const t = strings(lang).news;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const href = `${base}${lang}/news/${post.slug}/`;
const Heading = `h${headingLevel}`;
const date = new Intl.DateTimeFormat(lang, { dateStyle: 'long' });
---
<article class:list={['news-card', { 'has-image': post.image, 'news-card-row': row }]} data-kind={post.kind}>
  {post.image && (
    <Image class="news-card-image" src={post.image} alt="" widths={[400, 800]} sizes={row ? '(max-width: 760px) 100vw, 26rem' : '(max-width: 760px) 100vw, 24rem'} loading="lazy" />
  )}
  <div class="news-card-body">
    <p class="news-meta">
      <span class:list={['kind', `kind-${post.kind}`]}>{t.kinds[post.kind]}</span>
      <time datetime={post.date.toISOString().slice(0, 10)}>{date.format(post.date)}</time>
    </p>
    <Heading class="news-card-title"><a href={href} lang={post.translated ? undefined : post.lang}>{post.title}</a></Heading>
    {post.summary && <p class="news-card-summary" lang={post.translated ? undefined : post.lang}>{post.summary}</p>}
  </div>
</article>
