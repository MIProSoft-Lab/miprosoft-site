---
// Page shell shared by every page: top bar (institution, languages, theme),
// masthead with the group name and navigation, and footer.
//   path:         the page's path after the language, e.g. "team/jane-doe/" ("" for the home page)
//   nav:          the navigation entry to mark as current: home | news | team | research | teaching
//   subnav:       the entry of its menu to mark as current (research: lines | publications | theses | tools;
//                 teaching: courses | tools)
//   jsonLd:       optional schema.org object
//   lastModified: shown in the footer
//   share:        optional, for the preview shown when the page is shared on
//                 LinkedIn and others (Open Graph): { title, image: { src, width,
//                 height, alt }, published: Date, authors: [name] }. Pages
//                 with `published` are articles. Without it, the page's title
//                 and description are used, with the group's logo as image.
//   noindex:      keep search engines from indexing the page (e.g. the 404 page);
//                 it then has no canonical address or language versions.
// Slots: "hero" (full-width band above the content) and the default slot.
import '../styles/site.css';
import { languages, group, defaultLang, courses, toolsFor, goatcounter } from '../lib/data.js';
import { strings, ui, loc } from '../lib/i18n.js';
import SocialLinks from '../components/SocialLinks.astro';

const { lang, title, description, path = '', nav, subnav, jsonLd, lastModified, share = {}, noindex = false } = Astro.props;
const t = strings(lang);
const L = (x) => loc(x, lang, defaultLang);
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const href = (l) => `${base}${l}/${path}`;
const home = `${base}${lang}/`;
const groupName = L(group.name);
const fullName = L(group.fullName);
const institution = group.institution;

// Open Graph (LinkedIn, WhatsApp, Teams…) and Twitter cards.
const canonical = new URL(href(lang), Astro.site).href;
const ogLocale = (l) => ({ en: 'en_GB', ca: 'ca_ES', es: 'es_ES' })[l] ?? l;
// Without an image of its own, the group's logo (public/logo.png, also the favicon).
const logo = { src: `${base}logo.png`, width: 512, height: 512, alt: groupName };
const ogImage = { ...(share.image ?? logo), src: new URL((share.image ?? logo).src, Astro.site).href };

const links = [
  { id: 'home', label: t.nav.home, href: home },
  { id: 'news', label: t.nav.news, href: `${home}news/` },
  { id: 'team', label: t.nav.team, href: `${home}team/` },
  {
    id: 'research',
    label: t.nav.research,
    // A menu: opens on hover (and on click or tap, for touch screens and keyboards).
    items: [
      { id: 'lines', label: t.research.lines, href: `${home}research/lines/` },
      { id: 'publications', label: t.research.publications, href: `${home}research/publications/` },
      { id: 'theses', label: t.research.theses, href: `${home}research/theses/` },
      toolsFor('research').length > 0 && { id: 'tools', label: t.tools.title, href: `${home}research/tools/` },
    ].filter(Boolean),
  },
  {
    id: 'teaching',
    label: t.nav.teaching,
    // Each page only when it has content; the menu only when one of them has.
    items: [
      courses.length > 0 && { id: 'courses', label: t.courses.title, href: `${home}teaching/courses/` },
      toolsFor('teaching').length > 0 && { id: 'tools', label: t.tools.title, href: `${home}teaching/tools/` },
    ].filter(Boolean),
  },
].filter((l) => !l.items || l.items.length);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Apply the saved theme before first paint to avoid a flash.
      try {
        const theme = localStorage.getItem('theme');
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
    <noscript><style>.section-body[hidden] { display: block !important; } .section-toggle::before { display: none !important; }</style></noscript>
    <!-- Pre-launch: keeps search engines from indexing the site. Remove this line when it goes public. -->
    <meta name="robots" content="noindex, nofollow" />
    {noindex && <meta name="robots" content="noindex" />}
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/png" href={`${base}logo.png`} />
    <link rel="apple-touch-icon" href={`${base}logo.png`} />
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta property="og:site_name" content={groupName} />
    <meta property="og:title" content={share.title ?? title} />
    {description && <meta property="og:description" content={description} />}
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:type" content={share.published ? 'article' : 'website'} />
    <meta property="og:locale" content={ogLocale(lang)} />
    {languages.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={ogLocale(l)} />)}
    <meta property="og:image" content={ogImage.src} />
    <meta property="og:image:width" content={String(ogImage.width)} />
    <meta property="og:image:height" content={String(ogImage.height)} />
    {ogImage.alt && <meta property="og:image:alt" content={ogImage.alt} />}
    {share.published && <meta property="article:published_time" content={share.published.toISOString().slice(0, 10)} />}
    {(share.authors ?? []).map((a) => <meta property="article:author" content={a} />)}
    <meta name="twitter:card" content={share.image ? 'summary_large_image' : 'summary'} />
    {!noindex && languages.map((l) => <link rel="alternate" hreflang={l} href={new URL(href(l), Astro.site)} />)}
    {!noindex && <link rel="alternate" hreflang="x-default" href={new URL(base, Astro.site)} />}
    {goatcounter && import.meta.env.PROD && <script is:inline data-goatcounter={goatcounter} async src="https://gc.zgo.at/count.js"></script>}
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />}
  </head>
  <body>
    <a class="skip-link" href="#content">{t.skipToContent}</a>

    <header class="site-header">
      <div class="topbar">
        <div class="container topbar-inner">
          {institution?.name
            ? <a class="institution" href={institution.url}>{L(institution.name)}</a>
            : <span></span>}
          <div class="topbar-tools">
            <ul class="langs" aria-label="Language">
              {languages.map((l) => (
                <li><a href={href(l)} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined} title={ui[l]?.langName}><span class="lang-full">{ui[l]?.langName ?? l}</span><span class="lang-code" aria-hidden="true">{l.toUpperCase()}</span></a></li>
              ))}
            </ul>
            <button type="button" class="theme-toggle" data-label-dark={t.themeDark} data-label-light={t.themeLight} aria-label={t.themeDark} title={t.themeDark}>
              <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
              <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
            </button>
          </div>
        </div>
      </div>
      <div class="masthead">
        <div class="container masthead-inner">
          <a class="brand" href={home}>
            <span class="brand-name">{groupName}</span>
            {fullName ? <span class="brand-fullname">{fullName}</span> : <span class="brand-tagline">{t.researchGroup}</span>}
          </a>
          <button type="button" class="nav-toggle" aria-expanded="false" aria-controls="main-nav" aria-label={t.nav.menu}>
            <span class="nav-toggle-bars" aria-hidden="true"><span></span><span></span><span></span></span>
          </button>
          <nav class="main-nav" id="main-nav" aria-label={t.nav.home}>
            <ul>
              {links.map((l) => l.items ? (
                <li class:list={['has-menu', { current: l.id === nav }]}>
                  <button type="button" class="menu-toggle" aria-expanded="false" aria-controls={`menu-${l.id}`}>{l.label}</button>
                  <span class="menu-label" aria-hidden="true">{l.label}</span>
                  <ul class="menu" id={`menu-${l.id}`}>
                    {l.items.map((i) => <li><a href={i.href} aria-current={l.id === nav && i.id === subnav ? 'page' : undefined}>{i.label}</a></li>)}
                  </ul>
                </li>
              ) : (
                <li><a href={l.href} aria-current={l.id === nav ? 'page' : undefined}>{l.label}</a></li>
              ))}
            </ul>
          </nav>
        </div>
      </div>
    </header>

    <main id="content">
      <slot name="hero" />
      <div class="container page">
        <slot />
      </div>
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <div>
          <p class="footer-name">{groupName}</p>
          <p>{t.researchGroup}{institution?.name && <> · <a href={institution.url}>{L(institution.name)}</a></>}</p>
          <SocialLinks lang={lang} class="footer-social" />
        </div>
        <div class="footer-meta">
          <p>
            <slot name="footer">{t.sourceOrcid} <a href="https://orcid.org">ORCID</a></slot>
            {' '}· {t.metrics.source} <a href="https://openalex.org">OpenAlex</a>
          </p>
          {goatcounter && <p>{t.analyticsNote} <a href="https://www.goatcounter.com">GoatCounter</a></p>}
          {lastModified && <p>{t.lastUpdated}: {new Intl.DateTimeFormat(lang, { dateStyle: 'long' }).format(new Date(lastModified))}</p>}
        </div>
      </div>
    </footer>

    <script>
      const toggle = document.querySelector('.theme-toggle');
      const root = document.documentElement;
      const systemDark = matchMedia('(prefers-color-scheme: dark)');
      const current = () => root.dataset.theme ?? (systemDark.matches ? 'dark' : 'light');
      const label = () => {
        const text = current() === 'dark' ? toggle.dataset.labelLight : toggle.dataset.labelDark;
        toggle.setAttribute('aria-label', text);
        toggle.title = text;
      };
      toggle.addEventListener('click', () => {
        root.dataset.theme = current() === 'dark' ? 'light' : 'dark';
        try { localStorage.setItem('theme', root.dataset.theme); } catch {}
        label();
      });
      systemDark.addEventListener('change', label);
      label();

      // Phones: the navigation is a panel under the masthead, opened by the
      // menu button; Escape or a click outside the header closes it.
      const masthead = document.querySelector('.masthead');
      const navToggle = masthead.querySelector('.nav-toggle');
      const setNav = (open) => {
        masthead.classList.toggle('nav-open', open);
        navToggle.setAttribute('aria-expanded', String(open));
      };
      navToggle.addEventListener('click', () => setNav(!masthead.classList.contains('nav-open')));
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && masthead.classList.contains('nav-open')) { setNav(false); navToggle.focus(); }
      });
      document.addEventListener('click', (e) => {
        if (!e.target.closest('.site-header')) setNav(false);
      });

      // Navigation menus (Research): hover opens them with CSS; this adds
      // click/tap, Escape, and closing when clicking elsewhere.
      const menus = [...document.querySelectorAll('.main-nav .has-menu')];
      const setOpen = (item, open) => {
        item.classList.toggle('open', open);
        item.querySelector('.menu-toggle').setAttribute('aria-expanded', String(open));
      };
      for (const item of menus) {
        const button = item.querySelector('.menu-toggle');
        button.addEventListener('click', () => {
          const open = !item.classList.contains('open');
          for (const other of menus) if (other !== item) setOpen(other, false);
          setOpen(item, open);
        });
        item.addEventListener('mouseenter', () => button.setAttribute('aria-expanded', 'true'));
        item.addEventListener('mouseleave', () => setOpen(item, false));
        item.addEventListener('keydown', (e) => {
          if (e.key !== 'Escape' || !item.classList.contains('open')) return;
          setOpen(item, false);
          button.focus();
        });
        item.addEventListener('focusout', (e) => {
          if (!item.contains(e.relatedTarget)) setOpen(item, false);
        });
      }
      document.addEventListener('click', (e) => {
        for (const item of menus) if (!item.contains(e.target)) setOpen(item, false);
      });

      // Citation boxes (```cite in Markdown, see src/lib/cite.js): without
      // JavaScript every format is shown; this turns them into tabs (with arrow
      // keys, Home and End) and makes the copy button copy the visible one.
      for (const box of document.querySelectorAll('[data-cite]')) {
        const tabs = [...box.querySelectorAll('[role="tab"]')];
        const panels = tabs.map((tab) => document.getElementById(tab.getAttribute('aria-controls')));
        const copy = box.querySelector('.cite-copy');
        const copyLabel = copy.querySelector('span');
        const copyText = copyLabel.textContent;
        const select = (i, focus) => {
          tabs.forEach((tab, k) => {
            tab.setAttribute('aria-selected', String(k === i));
            tab.tabIndex = k === i ? 0 : -1;
            panels[k].hidden = k !== i;
          });
          if (focus) tabs[i].focus();
          copyLabel.textContent = copyText;
        };
        tabs.forEach((tab, i) => {
          tab.addEventListener('click', () => select(i));
          tab.addEventListener('keydown', (e) => {
            const to = { ArrowRight: i + 1, ArrowLeft: i - 1, Home: 0, End: tabs.length - 1 }[e.key];
            if (to === undefined) return;
            e.preventDefault();
            select((to + tabs.length) % tabs.length, true);
          });
        });
        copy.addEventListener('click', async () => {
          const panel = panels[tabs.findIndex((tab) => tab.getAttribute('aria-selected') === 'true')];
          const text = panel.querySelector('.cite-text, .cite-code').innerText.trim();
          try {
            await navigator.clipboard.writeText(text);
            copyLabel.textContent = copy.dataset.copied;
          } catch {
            copyLabel.textContent = copy.dataset.failed;
          }
          setTimeout(() => { copyLabel.textContent = copyText; }, 2000);
        });
        box.classList.add('cite-ready');
        select(0);
      }
    </script>
  </body>
</html>
