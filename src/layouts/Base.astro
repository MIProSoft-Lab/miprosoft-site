---
// Page shell shared by every page: head, toolbar (languages, actions, theme), footer.
//   path:        the page's path after the language, e.g. "people/jane-doe/" ("" for the home page)
//   actions:     extra toolbar links, [{ label, href, download? }]
//   jsonLd:      optional schema.org object
//   lastModified: shown in the footer
import '../styles/cv.css';
import { languages } from '../lib/data.js';
import { strings, ui } from '../lib/i18n.js';

const { lang, title, description, path = '', actions = [], jsonLd, lastModified, homeLabel } = Astro.props;
const t = strings(lang);
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const href = (l) => `${base}${l}/${path}`;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Apply the saved theme before first paint to avoid a flash.
      try {
        const theme = localStorage.getItem('theme');
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
    <noscript><style>.section-body[hidden] { display: block !important; } .section-toggle::before { display: none; }</style></noscript>
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {languages.map((l) => <link rel="alternate" hreflang={l} href={new URL(href(l), Astro.site)} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(base, Astro.site)} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <nav class="toolbar" aria-label="Site">
      <ul class="langs">
        {homeLabel && path && <li class="home"><a href={`${base}${lang}/`}>{homeLabel}</a></li>}
        {languages.map((l) => (
          <li><a href={href(l)} hreflang={l} lang={l} aria-current={l === lang ? 'page' : undefined} title={ui[l]?.langName}><span class="lang-full">{ui[l]?.langName ?? l}</span><span class="lang-code" aria-hidden="true">{l.toUpperCase()}</span></a></li>
        ))}
      </ul>
      <ul class="actions">
        {actions.map((a) => <li><a href={a.href} download={a.download || undefined}>{a.label}</a></li>)}
        <li><button type="button" onclick="window.print()">{t.print}</button></li>
        <li>
          <button type="button" class="theme-toggle" data-label-dark={t.themeDark} data-label-light={t.themeLight} aria-label={t.themeDark} title={t.themeDark}>
            <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
            <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
          </button>
        </li>
      </ul>
    </nav>

    <main>
      <slot />
    </main>

    <script>
      const toggle = document.querySelector('.theme-toggle');
      const root = document.documentElement;
      const systemDark = matchMedia('(prefers-color-scheme: dark)');
      const current = () => root.dataset.theme ?? (systemDark.matches ? 'dark' : 'light');
      const label = () => {
        const text = current() === 'dark' ? toggle.dataset.labelLight : toggle.dataset.labelDark;
        toggle.setAttribute('aria-label', text);
        toggle.title = text;
      };
      toggle.addEventListener('click', () => {
        root.dataset.theme = current() === 'dark' ? 'light' : 'dark';
        try { localStorage.setItem('theme', root.dataset.theme); } catch {}
        label();
      });
      systemDark.addEventListener('change', label);
      label();
    </script>

    <footer>
      <slot name="footer">{t.sourceOrcid} <a href="https://orcid.org">ORCID</a></slot>
      {lastModified && <> · {t.lastUpdated}: {new Intl.DateTimeFormat(lang, { dateStyle: 'long' }).format(new Date(lastModified))}</>}
    </footer>
  </body>
</html>
