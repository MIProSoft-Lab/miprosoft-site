---
// Courses taught by members of the group, current and past (content/courses/*.yaml).
import Base from '../../../../layouts/Base.astro';
import PageHead from '../../../../components/PageHead.astro';
import PeopleList from '../../../../components/PeopleList.astro';
import { courses, courseTypes, group, languages, defaultLang } from '../../../../lib/data.js';
import { strings, loc } from '../../../../lib/i18n.js';
import { courseText, courseFacts, courseMoreInfo } from '../../../../lib/courses.js';

// Only built when there are courses (the menu entry is hidden otherwise).
export function getStaticPaths() {
  return courses.length ? languages.map((lang) => ({ params: { lang } })) : [];
}

const { lang } = Astro.params;
const t = strings(lang);
const c = t.courses;
const L = (x) => loc(x, lang, defaultLang);
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

// Each course's texts in this language (or the default one where missing), the
// facts shown next to it, and where "More information" leads (its own page, if
// it has page text, or its external link).
const list = courses.map((course) => {
  const text = courseText(course, lang);
  return { ...course, text, facts: courseFacts(course, text, lang), moreInfo: courseMoreInfo(course, lang) };
});
// The types of the courses listed, for the filter (shown if there is more than one).
const types = courseTypes.filter((type) => list.some((course) => course.type === type));
---
<Base lang={lang} nav="teaching" subnav="courses" path="teaching/courses/" title={`${c.title} — ${loc(group.name, lang, defaultLang)}`} description={c.lead} lastModified={null}
  jsonLd={{
    '@context': 'https://schema.org',
    '@graph': list.map((course) => ({
      '@type': 'Course',
      name: course.text.title,
      description: course.text.summary || undefined,
      url: course.moreInfo ? new URL(course.moreInfo, Astro.site).href : undefined,
      provider: { '@type': 'Organization', name: course.text.institution || loc(group.name, lang, defaultLang) },
    })),
  }}
>
  <PageHead slot="hero" title={c.title} lead={c.lead} crumbs={[{ label: t.nav.home, href: `${base}${lang}/` }, { label: t.nav.teaching }]} />

  {types.length > 1 && (
    <div class="course-filter" role="group" aria-labelledby="course-filter-label">
      <span class="course-filter-label" id="course-filter-label">{c.filterLabel}</span>
      {['all', ...types].map((type, i) => (
        <button type="button" data-type={type} aria-pressed={String(i === 0)}>
          {type === 'all' ? c.all : c.typeGroups[type]}
          <span class="course-filter-count">{type === 'all' ? list.length : list.filter((course) => course.type === type).length}</span>
        </button>
      ))}
    </div>
  )}

  <ul class="card-list course-list">
    {list.map((course) => (
      <li class="card course" id={course.id} data-type={course.type}>
        <div class="card-main">
          {course.type && <p class="news-meta"><span class="kind kind-news">{c.types[course.type] ?? course.type}</span></p>}
          <h2 class="card-title" lang={course.text.translated ? undefined : course.text.lang}>{course.hasPage ? <a href={course.moreInfo}>{course.text.title}</a> : course.text.title}</h2>
          {course.text.summary && <p class="card-summary" lang={course.text.translated ? undefined : course.text.lang}>{course.text.summary}</p>}
          {course.instructors.length > 0 && (
            <div class="card-people">
              <h3>{c.instructors}</h3>
              <PeopleList people={course.instructors} lang={lang} />
            </div>
          )}
        </div>
        <div class="card-side">
          {course.facts.length > 0 && (
            <dl class="course-facts">
              {course.facts.map(([label, value]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}
            </dl>
          )}
          {course.moreInfo && <a class="button" href={course.moreInfo}>{c.moreInfo}<span class="visually-hidden">: {course.text.title}</span> <span aria-hidden="true">→</span></a>}
        </div>
      </li>
    ))}
  </ul>
</Base>

<script>
  const buttons = document.querySelectorAll('.course-filter button');
  for (const button of buttons) {
    button.addEventListener('click', () => {
      const type = button.dataset.type;
      for (const b of buttons) b.setAttribute('aria-pressed', String(b === button));
      for (const card of document.querySelectorAll('.course-list > .course')) {
        card.hidden = type !== 'all' && card.dataset.type !== type;
      }
    });
  }
</script>
