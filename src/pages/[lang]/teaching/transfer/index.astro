---
// The knowledge transfer page became the Tools pages: send old links to the
// teaching tools, or to the research ones if there are none.
import Redirect from '../../../../components/Redirect.astro';
import { toolsFor, languages } from '../../../../lib/data.js';

export function getStaticPaths() {
  const to = toolsFor('teaching').length ? 'teaching' : toolsFor('research').length ? 'research' : null;
  return to ? languages.map((lang) => ({ params: { lang }, props: { to } })) : [];
}

const { lang } = Astro.params;
const { to } = Astro.props;
---
<Redirect to={`${lang}/${to}/tools/`} />
