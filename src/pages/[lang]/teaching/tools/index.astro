---
// Tools for teaching (content/tools/*.yaml tagged "teaching").
import ToolList from '../../../../components/ToolList.astro';
import { toolsFor, languages } from '../../../../lib/data.js';

// Only built when there are such tools (the menu entry is hidden otherwise).
export function getStaticPaths() {
  return toolsFor('teaching').length ? languages.map((lang) => ({ params: { lang } })) : [];
}

const { lang } = Astro.params;
---
<ToolList lang={lang} section="teaching" />
