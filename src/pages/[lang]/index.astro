---
// Group home page: introduction and figures, latest news, people, latest publications.
import Base from '../../layouts/Base.astro';
import MemberCard from '../../components/MemberCard.astro';
import Publications from '../../components/Publications.astro';
import NewsCard from '../../components/NewsCard.astro';
import { getPosts, inLanguage } from '../../lib/news.js';
import { members, group, config, languages, defaultLang } from '../../lib/data.js';
import { strings, loc } from '../../lib/i18n.js';

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const LATEST = 5;
const LATEST_NEWS = 3;

const { lang } = Astro.params;
const t = strings(lang);
const L = (x) => loc(x, lang, defaultLang);
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const features = config.features ?? {};
const name = L(group.name);
const description = L(group.description);
const institution = group.institution;
const news = (await getPosts()).slice(0, LATEST_NEWS).map((p) => inLanguage(p, lang));
const fmt = new Intl.NumberFormat(lang, { notation: 'compact', maximumFractionDigits: 1 });

const showCitations = features.citations !== false && group.metrics.citations > 0;
const figures = [
  [t.metrics.members, members.length],
  [t.metrics.publications, group.metrics.publications],
  showCitations && [t.metrics.citations, group.metrics.citations],
  showCitations && [t.metrics.hIndex, group.metrics.hIndex],
].filter(Boolean);
---
<Base
  lang={lang}
  nav="home"
  title={name ? `${name} — ${t.researchGroup}` : t.researchGroup}
  description={description || [name, t.researchGroup, institution?.name && L(institution.name)].filter(Boolean).join(' · ')}
  lastModified={group.lastModified}
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'ResearchOrganization',
    name: name || undefined,
    description: description || undefined,
    parentOrganization: institution?.name ? { '@type': 'CollegeOrUniversity', name: L(institution.name), url: institution.url } : undefined,
    member: members.map((m) => ({ '@type': 'Person', name: m.name, url: new URL(`${base}${lang}/people/${m.id}/`, Astro.site).href })),
  }}
>
  <section slot="hero" class="hero">
    <div class="container hero-inner">
      <div class="hero-text">
        <p class="eyebrow">{t.researchGroup}{institution?.name && <> · {L(institution.name)}</>}</p>
        <h1>{name}</h1>
        {description && <p class="hero-lead">{description}</p>}
      </div>
      <dl class="hero-figures" aria-label={t.groupFigures}>
        {figures.map(([label, value]) => (
          <div><dt>{label}</dt><dd>{fmt.format(value)}</dd></div>
        ))}
      </dl>
    </div>
  </section>

  {news.length > 0 && (
    <section class="block" aria-labelledby="news-heading">
      <div class="block-head">
        <h2 id="news-heading">{t.news.latest}</h2>
        <a class="more" href={`${base}${lang}/news/`}>{t.news.all} <span aria-hidden="true">→</span></a>
      </div>
      <div class="news-rows">{news.map((p) => <NewsCard post={p} lang={lang} row />)}</div>
    </section>
  )}

  <section class="block" aria-labelledby="people-heading">
    <div class="block-head">
      <h2 id="people-heading">{t.nav.people}</h2>
    </div>
    <ul class="member-grid">
      {members.map((m) => <MemberCard member={m} lang={lang} />)}
    </ul>
  </section>

  {group.works.length > 0 && (
    <section class="block" aria-labelledby="latest-heading">
      <div class="block-head">
        <h2 id="latest-heading">{t.latestPublications}</h2>
        <a class="more" href={`${base}${lang}/publications/`}>{t.allPublications} ({group.works.length}) <span aria-hidden="true">→</span></a>
      </div>
      <Publications
        works={group.works.slice(0, LATEST)}
        lang={lang}
        members={members}
        flat
        showCitations={features.citations !== false}
        showAbstracts={features.abstracts !== false}
        showImpactFactor={features.impactFactor !== false}
      />
    </section>
  )}
</Base>
