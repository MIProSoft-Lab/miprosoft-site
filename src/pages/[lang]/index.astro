---
// Group home page: for now, the list of members linking to their CVs.
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import { members, group, config, languages, defaultLang } from '../../lib/data.js';
import { strings, loc } from '../../lib/i18n.js';

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = strings(lang);
const L = (x) => loc(x, lang, defaultLang);
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const features = config.features ?? {};
const name = L(group.name);
const description = L(group.description);

const actions = [
  features.bibtex !== false && group.works.length > 0 && { label: t.downloadBib, href: `${base}publications.bib`, download: true },
].filter(Boolean);
---
<Base
  lang={lang}
  title={name || t.sections.members}
  description={description || undefined}
  actions={actions}
  lastModified={group.lastModified}
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'ResearchOrganization',
    name: name || undefined,
    member: members.map((m) => ({ '@type': 'Person', name: m.profile.name, url: new URL(`${base}${lang}/people/${m.id}/`, Astro.site).href })),
  }}
>
  <header class="header">
    <div>
      {name && <h1>{name}</h1>}
      {description && <p class="headline">{description}</p>}
    </div>
  </header>

  <Section id="members" title={t.sections.members}>
    <ul class="members">
      {members.map((m) => (
        <li>
          <a class="member-name" href={`${base}${lang}/people/${m.id}/`}>{m.profile.name}</a>
          {L(m.profile.title) && <span class="meta">{L(m.profile.title)}</span>}
        </li>
      ))}
    </ul>
  </Section>
</Base>
