---
import '../../styles/cv.css';
import Section from '../../components/Section.astro';
import Entry from '../../components/Entry.astro';
import Publications from '../../components/Publications.astro';
import { cv, config, languages, defaultLang, hasContent } from '../../lib/data.js';
import { strings, loc, ui } from '../../lib/i18n.js';
import { formatRange, formatDate, formatPlace } from '../../lib/format.js';

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = strings(lang);
const L = (x) => loc(x, lang, defaultLang);
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const features = config.features ?? {};
const sections = (config.sections ?? []).filter(hasContent);
const title = L(cv.profile.title);
const aboutText = L(cv.about);

const orgLine = (it) => [it.department, it.organization?.name].filter(Boolean).join(', ');
const affiliationEntry = (it) => ({
  when: formatRange(it.start, it.end, lang),
  title: L(it.role) || orgLine(it),
  subtitle: L(it.role) ? orgLine(it) : '',
  meta: formatPlace(it.organization, lang),
  description: L(it.description),
  url: it.url,
});
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Apply the saved theme before first paint to avoid a flash.
      try {
        const theme = localStorage.getItem('theme');
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
    <title>{cv.profile.name}{title && ` — ${title}`}</title>
    <meta name="description" content={`${cv.profile.name}${title ? ', ' + title : ''}. ${t.sections.publications}, ${t.sections.employment.toLowerCase()}.`} />
    {languages.map((l) => <link rel="alternate" hreflang={l} href={new URL(`${base}${l}/`, Astro.site)} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(base, Astro.site)} />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: cv.profile.name,
      jobTitle: title || undefined,
      sameAs: [`https://orcid.org/${cv.orcidId}`, ...cv.profile.links.map((l) => l.url)],
    })} />
  </head>
  <body>
    <nav class="toolbar" aria-label="Site">
      <ul class="langs">
        {languages.map((l) => (
          <li><a href={`${base}${l}/`} hreflang={l} lang={l} aria-current={l === lang ? 'page' : undefined} title={ui[l]?.langName}><span class="lang-full">{ui[l]?.langName ?? l}</span><span class="lang-code" aria-hidden="true">{l.toUpperCase()}</span></a></li>
        ))}
      </ul>
      <ul class="actions">
        {features.pdf !== false && <li><a href={`${base}cv-${lang}.pdf`}>{t.downloadPdf}</a></li>}
        {features.bibtex !== false && cv.works.length > 0 && <li><a href={`${base}publications.bib`} download>{t.downloadBib}</a></li>}
        <li><button type="button" onclick="window.print()">{t.print}</button></li>
        <li>
          <button type="button" class="theme-toggle" data-label-dark={t.themeDark} data-label-light={t.themeLight} aria-label={t.themeDark} title={t.themeDark}>
            <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
            <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
          </button>
        </li>
      </ul>
    </nav>

    <main>
      <header class="header">
        {cv.profile.photo && <img class="photo" src={`${base}${cv.profile.photo.replace(/^\//, '')}`} alt="" width="120" height="120" />}
        <div>
          <h1>{cv.profile.name}</h1>
          {title && <p class="headline">{title}</p>}
          <ul class="contact">
            {cv.profile.location && <li>{cv.profile.location}</li>}
            {cv.profile.email && <li><a href={`mailto:${cv.profile.email}`}>{cv.profile.email}</a></li>}
            <li><a class="orcid" href={`https://orcid.org/${cv.orcidId}`}>ORCID {cv.orcidId}</a></li>
            {cv.profile.links.map((l) => <li><a href={l.url}>{l.label}</a></li>)}
          </ul>
        </div>
      </header>

      {sections.map((s) => (
        <Section id={s} title={t.sections[s]}>
          {s === 'about' && (
            <>
              {aboutText && aboutText.split(/\r?\n\s*\r?\n/).map((p) => <p>{p}</p>)}
              {cv.profile.keywords.length > 0 && (
                <p class="keywords"><span>{t.keywords}:</span> {cv.profile.keywords.join(' · ')}</p>
              )}
            </>
          )}

          {['employment', 'education', 'distinctions', 'invitedPositions', 'memberships', 'service'].includes(s) &&
            cv[s].map((it) => <Entry {...affiliationEntry(it)} />)}

          {s === 'publications' && (
            <Publications works={cv.works} lang={lang} nameVariants={cv.nameVariants} familyName={cv.familyName} givenNames={cv.givenNames} showCitations={features.citations !== false} />
          )}

          {s === 'funding' && cv.funding.map((f) => (
            <Entry
              when={formatRange(f.start, f.end, lang)}
              title={L(f.title)}
              subtitle={f.organization?.name}
              meta={f.grantNumber && `${t.grant} ${f.grantNumber}`}
              description={L(f.description)}
              url={f.url}
            />
          ))}

          {s === 'talks' && cv.talks.map((tk) => (
            <Entry
              when={formatDate(tk.date, lang)}
              title={L(tk.title)}
              url={tk.url}
              subtitle={[L(tk.event), L(tk.location)].filter(Boolean).join(', ')}
              meta={tk.invited ? t.invited : ''}
            />
          ))}

          {s === 'teaching' && cv.teaching.map((c) => (
            <Entry when={L(c.years)} title={L(c.course)} subtitle={[L(c.role), L(c.institution)].filter(Boolean).join(', ')} description={L(c.details)} />
          ))}

          {s === 'supervision' && cv.supervision.map((x) => (
            <Entry when={L(x.years)} title={L(x.title)} subtitle={[x.student, L(x.level)].filter(Boolean).join(' — ')} meta={L(x.role)} />
          ))}

          {s === 'software' && cv.software.map((x) => (
            <Entry when="" title={x.name} url={x.url} description={L(x.description)} />
          ))}

          {s === 'peerReview' && (
            <ul class="inline-list">
              {cv.peerReview.map((r) => (
                <li>
                  {r.venue}{' '}
                  <span class="meta">({t.reviews(r.count)}{r.firstYear && `, ${r.firstYear === r.lastYear ? r.firstYear : `${r.firstYear}–${r.lastYear}`}`})</span>
                </li>
              ))}
            </ul>
          )}

          {s === 'skills' && (
            <dl class="pairs">
              {cv.skills.map((g) => (<><dt>{L(g.group)}</dt><dd>{(g.items ?? []).map(L).join(', ')}</dd></>))}
            </dl>
          )}

          {s === 'languages' && (
            <dl class="pairs">
              {cv.languages.map((x) => (<><dt>{L(x.language)}</dt><dd>{L(x.level)}</dd></>))}
            </dl>
          )}
        </Section>
      ))}
    </main>

    <script>
      const toggle = document.querySelector('.theme-toggle');
      const root = document.documentElement;
      const systemDark = matchMedia('(prefers-color-scheme: dark)');
      const current = () => root.dataset.theme ?? (systemDark.matches ? 'dark' : 'light');
      const label = () => {
        const text = current() === 'dark' ? toggle.dataset.labelLight : toggle.dataset.labelDark;
        toggle.setAttribute('aria-label', text);
        toggle.title = text;
      };
      toggle.addEventListener('click', () => {
        root.dataset.theme = current() === 'dark' ? 'light' : 'dark';
        try { localStorage.setItem('theme', root.dataset.theme); } catch {}
        label();
      });
      systemDark.addEventListener('change', label);
      label();
    </script>

    <footer>
      {t.sourceOrcid} <a href={`https://orcid.org/${cv.orcidId}`}>ORCID</a>
      {cv.lastModified && <> · {t.lastUpdated}: {new Intl.DateTimeFormat(lang, { dateStyle: 'long' }).format(new Date(cv.lastModified))}</>}
    </footer>
  </body>
</html>
