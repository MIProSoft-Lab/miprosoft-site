---
// One news or blog post: /<lang>/news/<slug>/. Every post is built in every
// language; a missing translation shows another language with a notice.
import { Image } from 'astro:assets';
import Base from '../../../../layouts/Base.astro';
import PeopleList from '../../../../components/PeopleList.astro';
import NewsCard from '../../../../components/NewsCard.astro';
import Publications from '../../../../components/Publications.astro';
import ToolCard from '../../../../components/ToolCard.astro';
import { group, members, config, tools, workKey, languages, defaultLang } from '../../../../lib/data.js';
import { getPosts, inLanguage, renderBody, relatedItems } from '../../../../lib/news.js';
import { strings, loc } from '../../../../lib/i18n.js';

export async function getStaticPaths() {
  const posts = await getPosts();
  return languages.flatMap((lang) => posts.map((p) => ({ params: { lang, slug: p.slug } })));
}

const { lang, slug } = Astro.params;
const t = strings(lang);
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const all = await getPosts();
const post = inLanguage(all.find((p) => p.slug === slug), lang);
const html = await renderBody(post, lang);
const date = new Intl.DateTimeFormat(lang, { dateStyle: 'long' });
const languageName = (l) => {
  try { return new Intl.DisplayNames([lang], { type: 'language' }).of(l); } catch { return l; }
};
// What the post is about: its publications as in the publication lists, its
// tools as on the Tools pages, and its theses and courses as short cards.
const features = config.features ?? {};
const relatedWorks = post.related.publications.map((key) => group.works.find((w) => workKey(w) === key));
const relatedTools = post.related.tools.map((id) => tools.find((x) => x.id === id));
const relatedOthers = relatedItems(post, lang).filter((x) => x.kind === 'thesis' || x.kind === 'course');
const hasRelated = relatedWorks.length + relatedTools.length + relatedOthers.length > 0;
// The next posts after this one, to keep reading.
const more = all.filter((p) => p.slug !== slug).slice(0, 3).map((p) => inLanguage(p, lang));
---
<Base
  lang={lang}
  nav="news"
  path={`news/${slug}/`}
  title={`${post.title} — ${loc(group.name, lang, defaultLang)}`}
  description={post.summary}
  lastModified={null}
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': post.kind === 'blog' ? 'BlogPosting' : 'NewsArticle',
    headline: post.title,
    datePublished: post.date.toISOString().slice(0, 10),
    inLanguage: post.lang,
    author: post.authors.map((a) => ({ '@type': 'Person', name: a.name })),
    publisher: { '@type': 'ResearchOrganization', name: loc(group.name, lang, defaultLang) },
  }}
>
  <div slot="hero" class="page-head post-head">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol>
          <li><a href={`${base}${lang}/`}>{t.nav.home}</a></li>
          <li><a href={`${base}${lang}/news/`}>{t.nav.news}</a></li>
        </ol>
      </nav>
      <p class="news-meta">
        <span class:list={['kind', `kind-${post.kind}`]}>{t.news.kinds[post.kind]}</span>
        <time datetime={post.date.toISOString().slice(0, 10)}>{date.format(post.date)}</time>
      </p>
      <h1 lang={post.translated ? undefined : post.lang}>{post.title}</h1>
      {post.authors.length > 0 && (
        <PeopleList people={post.authors} lang={lang} label={t.news.by} />
      )}
    </div>
  </div>

  <article class="post">
    {!post.translated && <p class="notice" role="note">{t.news.notTranslated(languageName(post.lang))}</p>}
    {post.image && (
      <Image class="post-image" src={post.image} alt={post.imageAlt} widths={[800, 1400]} sizes="(max-width: 760px) 100vw, 46rem" />
    )}
    <div class="prose" lang={post.translated ? undefined : post.lang} set:html={html} />
  </article>

  {hasRelated && (
    <section class="post-related" aria-labelledby="related-heading">
      <h2 id="related-heading">{t.news.related}</h2>
      <ul class="card-list">
        {relatedWorks.map((w) => (
          <li class="card related-card">
            <div class="card-main">
              <span class="related-kind">{[t.news.relatedKinds.publication, w.date?.year].filter(Boolean).join(' · ')}</span>
              <Publications
                works={[w]}
                lang={lang}
                members={members}
                post={post.slug}
                flat
                showCitations={features.citations !== false}
                showAbstracts={features.abstracts !== false}
                showImpactFactor={features.impactFactor !== false}
              />
            </div>
          </li>
        ))}
        {relatedTools.map((tool) => <ToolCard tool={tool} lang={lang} label={t.news.relatedKinds.tool} level={3} />)}
        {relatedOthers.map((x) => (
          <li class="card related-card">
            <div class="card-main" lang={x.lang}>
              <span class="related-kind">{[t.news.relatedKinds[x.kind], x.year].filter(Boolean).join(' · ')}</span>
              <h3 class="card-title"><a href={x.href}>{x.title}</a></h3>
              {x.meta && <p class="related-meta">{x.meta}</p>}
              {x.summary && <p class="card-summary">{x.summary}</p>}
            </div>
          </li>
        ))}
      </ul>
    </section>
  )}

  {more.length > 0 && (
    <section class="block post-more" aria-labelledby="more-heading">
      <div class="block-head">
        <h2 id="more-heading">{t.news.latest}</h2>
        <a class="more" href={`${base}${lang}/news/`}>{t.news.all} <span aria-hidden="true">→</span></a>
      </div>
      <div class="news-grid">{more.map((p) => <NewsCard post={p} lang={lang} />)}</div>
    </section>
  )}
</Base>
