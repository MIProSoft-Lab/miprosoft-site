---
// All news and blog posts, newest first, with a filter by kind.
import Base from '../../../layouts/Base.astro';
import PageHead from '../../../components/PageHead.astro';
import NewsCard from '../../../components/NewsCard.astro';
import { group, languages, defaultLang } from '../../../lib/data.js';
import { getPosts, inLanguage } from '../../../lib/news.js';
import { strings, loc } from '../../../lib/i18n.js';

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = strings(lang);
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const posts = (await getPosts()).map((p) => inLanguage(p, lang));
const kinds = ['news', 'blog'].filter((k) => posts.some((p) => p.kind === k));
---
<Base lang={lang} nav="news" path="news/" title={`${t.news.title} — ${loc(group.name, lang, defaultLang)}`} lastModified={group.lastModified}>
  <PageHead slot="hero" title={t.news.title} crumbs={[{ label: t.nav.home, href: `${base}${lang}/` }]} />

  {kinds.length > 1 && (
    <div class="pub-toggle news-filter" role="group">
      {['all', ...kinds].map((k, i) => (
        <button type="button" data-kind={k} aria-pressed={String(i === 0)}>
          {t.news.filters[k]} <span class="filter-count">{k === 'all' ? posts.length : posts.filter((p) => p.kind === k).length}</span>
        </button>
      ))}
    </div>
  )}

  {posts.length
    ? <div class="news-rows news-list">{posts.map((p) => <NewsCard post={p} lang={lang} headingLevel={2} row />)}</div>
    : <p class="empty">{t.news.empty}</p>}
</Base>

<script>
  const buttons = document.querySelectorAll('.news-filter button');
  for (const button of buttons) {
    button.addEventListener('click', () => {
      const kind = button.dataset.kind;
      for (const b of buttons) b.setAttribute('aria-pressed', String(b === button));
      for (const card of document.querySelectorAll('.news-list .news-card')) {
        card.hidden = kind !== 'all' && card.dataset.kind !== kind;
      }
    });
  }
</script>
