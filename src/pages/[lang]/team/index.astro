---
// The team: the group's members (principal investigators first), then the
// collaborators from other groups.
import Base from '../../../layouts/Base.astro';
import PageHead from '../../../components/PageHead.astro';
import MemberCard from '../../../components/MemberCard.astro';
import CollaboratorCard from '../../../components/CollaboratorCard.astro';
import { team, collaborators, group, languages, defaultLang } from '../../../lib/data.js';
import { strings, loc } from '../../../lib/i18n.js';

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = strings(lang);
const L = (x) => loc(x, lang, defaultLang);
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const name = L(group.name);
---
<Base lang={lang} nav="team" path="team/" description={t.descriptions.team} title={`${t.nav.team} — ${name}`} lastModified={group.lastModified}>
  <PageHead slot="hero" title={t.nav.team} crumbs={[{ label: t.nav.home, href: `${base}${lang}/` }]} />
  <section class="block" aria-labelledby="members-heading">
    {collaborators.length > 0
      ? <div class="block-head"><h2 id="members-heading">{t.team.members}</h2></div>
      : <h2 id="members-heading" class="visually-hidden">{t.team.members}</h2>}
    <ul class="member-grid">
      {team.map((m) => <MemberCard member={m} lang={lang} />)}
    </ul>
  </section>
  {collaborators.length > 0 && (
    <section class="block" aria-labelledby="collaborators-heading">
      <div class="block-head"><h2 id="collaborators-heading">{t.team.collaborators}</h2></div>
      <ul class="member-grid">
        {collaborators.map((c) => <CollaboratorCard person={c} lang={lang} />)}
      </ul>
    </section>
  )}
</Base>
