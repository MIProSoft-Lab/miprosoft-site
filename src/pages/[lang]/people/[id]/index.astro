---
// Profiles used to be at /<lang>/people/<id>/: keep old links working.
import Redirect from '../../../../components/Redirect.astro';
import { members, languages } from '../../../../lib/data.js';

export function getStaticPaths() {
  return languages.flatMap((lang) => members.map((m) => ({ params: { lang, id: m.id } })));
}

const { lang, id } = Astro.params;
---
<Redirect to={`${lang}/team/${id}/`} />
