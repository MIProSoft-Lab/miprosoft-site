---
// All members of the group.
import Base from '../../../layouts/Base.astro';
import PageHead from '../../../components/PageHead.astro';
import MemberCard from '../../../components/MemberCard.astro';
import { members, group, languages, defaultLang } from '../../../lib/data.js';
import { strings, loc } from '../../../lib/i18n.js';

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = strings(lang);
const L = (x) => loc(x, lang, defaultLang);
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const name = L(group.name);
---
<Base lang={lang} nav="people" path="people/" title={`${t.nav.people} — ${name}`} lastModified={group.lastModified}>
  <PageHead slot="hero" title={t.nav.people} crumbs={[{ label: t.nav.home, href: `${base}${lang}/` }]} />
  <ul class="member-grid">
    {members.map((m) => <MemberCard member={m} lang={lang} />)}
  </ul>
</Base>
