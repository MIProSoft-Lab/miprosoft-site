---
// Theses supervised by members (content/theses/*.yaml): PhD, master's and
// bachelor's, each kind in its own group, newest first.
import Base from '../../../../layouts/Base.astro';
import PageHead from '../../../../components/PageHead.astro';
import ThesisList from '../../../../components/ThesisList.astro';
import { theses, group, languages, defaultLang } from '../../../../lib/data.js';
import { strings, loc } from '../../../../lib/i18n.js';

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = strings(lang);
const r = t.research;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const name = loc(group.name, lang, defaultLang);
---
<Base lang={lang} nav="research" subnav="theses" path="research/theses/" description={t.descriptions.theses} title={`${r.theses} — ${name}`} lastModified={null}>
  <PageHead slot="hero" title={t.research.theses} crumbs={[{ label: t.nav.home, href: `${base}${lang}/` }, { label: t.nav.research }]} />

  {theses.length
    ? <ThesisList theses={theses} lang={lang} />
    : <p class="empty">{r.thesesEmpty}</p>}
</Base>
