---
// The group's research lines (content/research-lines/*.yaml).
import Base from '../../../../layouts/Base.astro';
import PageHead from '../../../../components/PageHead.astro';
import PeopleList from '../../../../components/PeopleList.astro';
import { researchLines, group, languages, defaultLang } from '../../../../lib/data.js';
import { strings, loc } from '../../../../lib/i18n.js';
import { localize } from '../../../../lib/content.js';
import { markdown } from '../../../../lib/markdown.js';

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = strings(lang);
const r = t.research;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const name = loc(group.name, lang, defaultLang);
const lines = researchLines.map((line) => {
  const text = localize(line.entry, lang);
  return { ...line, text, html: markdown(text.description, lang) };
});
---
<Base lang={lang} nav="research" subnav="lines" path="research/lines/" title={`${r.lines} — ${name}`} lastModified={null}>
  <PageHead slot="hero" title={t.research.lines} crumbs={[{ label: t.nav.home, href: `${base}${lang}/` }, { label: t.nav.research }]} />

  {lines.length
    ? (
      <ul class="card-list">
        {lines.map((line) => (
          <li class="card" id={line.id}>
            <div class="card-main" lang={line.text.translated ? undefined : line.text.lang}>
              <h2 class="card-title">{line.text.title}</h2>
              {line.text.summary && <p class="card-summary">{line.text.summary}</p>}
              {line.html && <div class="prose card-text" set:html={line.html} />}
            </div>
            {line.members.length > 0 && (
              <div class="card-side">
                <div class="card-people">
                  <h3>{r.people}</h3>
                  <PeopleList people={line.members} lang={lang} stacked />
                </div>
              </div>
            )}
          </li>
        ))}
      </ul>
    )
    : <p class="empty">{r.linesEmpty}</p>}
</Base>
