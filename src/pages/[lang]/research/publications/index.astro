---
// The group's publications: every member's works, each paper once.
import Base from '../../../../layouts/Base.astro';
import PageHead from '../../../../components/PageHead.astro';
import Publications from '../../../../components/Publications.astro';
import { members, group, config, languages, defaultLang } from '../../../../lib/data.js';
import { strings, loc } from '../../../../lib/i18n.js';

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = strings(lang);
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const features = config.features ?? {};
const name = loc(group.name, lang, defaultLang);
---
<Base lang={lang} nav="research" subnav="publications" path="research/publications/" description={t.descriptions.publications} title={`${t.research.publications} — ${name}`} lastModified={group.lastModified}>
  <PageHead slot="hero" title={t.research.publications} crumbs={[{ label: t.nav.home, href: `${base}${lang}/` }, { label: t.nav.research }]} />
  <Publications
    works={group.works}
    lang={lang}
    members={members}
    showCitations={features.citations !== false}
    showAbstracts={features.abstracts !== false}
    showImpactFactor={features.impactFactor !== false}
  />
</Base>
