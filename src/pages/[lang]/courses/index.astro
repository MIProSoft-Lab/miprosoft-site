---
// The courses page used to be /<lang>/courses/: keep old links working.
import Redirect from '../../../components/Redirect.astro';
import { courses, languages } from '../../../lib/data.js';

export function getStaticPaths() {
  return courses.length ? languages.map((lang) => ({ params: { lang } })) : [];
}

const { lang } = Astro.params;
---
<Redirect to={`${lang}/teaching/courses/`} />
