---
// Root URL: send visitors to their browser's language if available.
import { languages, defaultLang, group } from '../lib/data.js';
import { loc } from '../lib/i18n.js';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<!doctype html>
<html lang={defaultLang}>
  <head>
    <meta charset="utf-8" />
    <!-- Pre-launch: keeps search engines from indexing the site. Remove this line when it goes public. -->
    <meta name="robots" content="noindex, nofollow" />
    <title>{loc(group.name, defaultLang, defaultLang)}</title>
    <script is:inline define:vars={{ languages, defaultLang, base }}>
      const pref = (navigator.languages || [navigator.language])
        .map((l) => l.toLowerCase().split('-')[0])
        .find((l) => languages.includes(l));
      location.replace(base + (pref || defaultLang) + '/');
    </script>
    <meta http-equiv="refresh" content={`1; url=${base}${defaultLang}/`} />
    <link rel="icon" type="image/png" href={`${base}logo.png`} />
    {languages.map((l) => <link rel="alternate" hreflang={l} href={new URL(`${base}${l}/`, Astro.site)} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(base, Astro.site)} />
  </head>
  <body>
    <ul>{languages.map((l) => <li><a href={`${base}${l}/`}>{l}</a></li>)}</ul>
  </body>
</html>
